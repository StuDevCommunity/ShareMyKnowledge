#!/bin/sh

echo ""
echo "🔍 Checking markdown files for rendering issues..."
echo ""

node scripts/check-render.mjs

if [ $? -ne 0 ]; then
  echo ""
  echo "══════════════════════════════════════════════════════"
  echo "❌ COMMIT BLOCKED: Markdown rendering issues detected!"
  echo "══════════════════════════════════════════════════════"
  echo ""
  echo "Fix the errors above before committing."
  echo ""
  echo "  Auto-fix encoding issues:"
  echo "    node scripts/check-render.mjs --fix"
  echo ""
  echo "  Re-check after fixing:"
  echo "    node scripts/check-render.mjs"
  echo ""
  echo "  Skip this check (not recommended):"
  echo "    git commit --no-verify"
  echo ""
  exit 1
fi

echo ""
echo "✅ All markdown files are render-safe. Proceeding with commit."
echo ""
